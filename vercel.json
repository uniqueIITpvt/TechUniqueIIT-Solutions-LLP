{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev",
      "outputDirectory": ".next"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm install",
      "devCommand": "npm run dev"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
